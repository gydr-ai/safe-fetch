{
  "name": "@gydr-ai/safe-fetch",
  "version": "0.1.3",
  "description": "SSRF-safe fetch for Node.js: blocks private and metadata addresses, pins the socket against DNS rebinding, re-checks every redirect, caps time and size.",
  "keywords": [
    "ssrf",
    "fetch",
    "dns-rebinding",
    "security",
    "webhook",
    "ai-agent",
    "mcp",
    "url-validation"
  ],
  "homepage": "https://github.com/gydr-ai/safe-fetch#readme",
  "bugs": "https://github.com/gydr-ai/safe-fetch/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gydr-ai/safe-fetch.git"
  },
  "license": "Apache-2.0",
  "author": "Gydr.ai",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1"
  },
  "packageManager": "pnpm@11.1.2",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm test:dist",
    "test:dist": "node scripts/check-dist.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/eslint-plugin": "1.6.28",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-jsdoc": "65.4.4",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
